# ==========================================
# GitHub Actions Self-Hosted Runner 設定
# ==========================================

# 1. 你的 GitHub 專案或組織網址
GITHUB_URL=https://github.com/your-username/your-repo

# 2. GitHub Runner 註冊 Token
# 前往專案頁面：Settings -> Actions -> Runners -> New self-hosted runner
# 複製指令中出現的 token（例如：AE7XXXXXXXXXXXXXXXXX）
RUNNER_TOKEN=YOUR_GITHUB_RUNNER_REGISTRATION_TOKEN

# 3. Runner 名稱（選用）
RUNNER_NAME=agent-flow-agy-runner

# 4. Runner 標籤（用逗號分隔，需包含 self-hosted 與 agy）
RUNNER_LABELS=self-hosted,agy,linux
